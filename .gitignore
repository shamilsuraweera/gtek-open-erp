# ==========================================
# G-TEK ERP Global .gitignore
# ==========================================

# 1. Dependencies
node_modules/
.pnp
.pnp.js

# 2. Build Artifacts & Caches
dist/
build/
.tmp/
temp/
.eslintcache
*.tsbuildinfo
.metro-cache/

# 3. Testing
coverage/

# 4. Environment & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
.npmrc
secrets.json

# 5. Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. OS / Editor / System Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 7. Mobile (React Native / Expo specific)
.expo/
.expo-shared/
/mobile/android/
/mobile/ios/

# 8. Cloud / CI Artifacts
.azure/
*.publishsettings
*.azureconfig
.github/*.log

# 9. Examples
example.server.gitignore
example.client.gitignore